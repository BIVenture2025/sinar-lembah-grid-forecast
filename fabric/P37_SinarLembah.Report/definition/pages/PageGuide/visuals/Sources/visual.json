              {
                "textRuns": [
                  {
                    "value": "Where the numbers come from",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#27221F",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Hourly batches land in the Eventhouse EH_SinarLembah. Update policies score each batch against the usual load and raise alerts as it arrives. OneLake availability exposes the tables to the Lakehouse LH_SinarLembah through shortcuts. The notebooks NB_SinarLembah_Gold and NB_SinarLembah_Forecast build the Gold tables and the day-ahead forecast, run by the pipeline PL_SinarLembah_Daily with a verdict gate after each step. This report reads them in Direct Lake through SM_SinarLembah.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#27221F"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "The data is synthetic, from a deterministic generator: load shapes by feeder type, temperature, growth and public holidays, plus planted events.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#635E57"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              }
            ]
          }
        }
