		sourceColumn: run_id
		lineageTag: cb029344-5e00-53ee-875d-912330791a4d

	partition Forecast = entity
		mode: directLake
		source
			entityName: gold_forecast_hourly
			expressionSource: 'DirectLake - LH_SinarLembah'
