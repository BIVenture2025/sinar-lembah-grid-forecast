		sourceColumn: is_backtest
		lineageTag: d3c7df7d-5888-5105-914a-00a604f1e36f

	column model_name
		dataType: string
		summarizeBy: none
		sourceColumn: model_name
		lineageTag: da9d0dc3-ceb7-55db-b331-6b5d11bae40e

