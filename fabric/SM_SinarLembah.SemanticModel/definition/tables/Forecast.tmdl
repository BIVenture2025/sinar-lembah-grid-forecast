		formatString: #,0.00
		summarizeBy: none
		sourceColumn: forecast_mw
		lineageTag: 5aedcf89-0b76-5145-8f45-6141cbdb2ace

	column lo_mw
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: lo_mw
		lineageTag: 10c401ef-a506-55bb-8e78-94f8d9468910

	column hi_mw
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: hi_mw
		lineageTag: 504dc9cf-a875-59bb-81f5-8c8dc5110da8

	column naive_mw
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: naive_mw
		lineageTag: c5379e9e-6092-521b-8625-951acc8edfd5

	column actual_mw
		dataType: double
		isHidden
		formatString: #,0.00
		summarizeBy: none
		sourceColumn: actual_mw
		lineageTag: 4ed4c6f2-3891-55fc-9884-fd40d5159ad7

	column fold
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: fold
		lineageTag: dd96da84-66a0-55e9-bd3c-732ce379805d

	column is_backtest
		dataType: boolean
