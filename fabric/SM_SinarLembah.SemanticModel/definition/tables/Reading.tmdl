/// Hourly readings scored against the usual load, 21 Sep to 22 Nov 2026 (KQL table reading_scored).
table Reading
	lineageTag: 14a87273-70aa-59fe-b36d-41dcffcd4c3a

	/// Last reading hour in the model; every 'last 24 hours' figure counts back from it.
	measure 'Cut-off' = CALCULATE ( MAX ( Reading[reading_hour] ), REMOVEFILTERS () )
		formatString: dd mmm yyyy hh:nn
		displayFolder: Base
		lineageTag: 81843945-4e5d-5380-8265-69a52581a97a

	/// Sum of hourly demand for the selection; at one hour it is MW, over a day it is MWh.
	measure 'Demand MW' = SUM ( Reading[demand_mw] )
		formatString: #,0.0
		displayFolder: Load
		lineageTag: b70a4a2e-3b98-5f50-a291-f52195178cf1

	/// Sum of the usual load (median for the feeder, hour and day type over the 12 weeks before).
	measure 'Usual MW' = SUM ( Reading[usual_mw] )
		formatString: #,0.0
		displayFolder: Load
		lineageTag: d7076956-8596-574a-817a-eb55e4d18ab4

	/// Highest hourly sum for the selection: the max of hourly sums, not the sum of peaks.
	measure 'Peak demand MW' = MAXX ( VALUES ( Reading[reading_hour] ), [Demand MW] )
		formatString: #,0.0
		displayFolder: Load
		lineageTag: 43c9b278-5225-511f-820d-b08f713e1a91

	/// Hourly demand in the 7 days up to the cut-off; blank before them (chart axis).
	measure 'Demand MW, last 7 days' =
			VAR c = [Cut-off]
			RETURN
				IF ( MAX ( Reading[reading_hour] ) > c - 7, [Demand MW] )
		formatString: #,0.00
		displayFolder: Load
		lineageTag: 4b944c05-39fe-5174-9355-92d819d4d4d2

	/// Usual load for the same hours.
	measure 'Usual MW, last 7 days' =
			VAR c = [Cut-off]
			RETURN
				IF ( MAX ( Reading[reading_hour] ) > c - 7, [Usual MW] )
		formatString: #,0.00
		displayFolder: Load
		lineageTag: 09e3bd3e-c1d6-5b2c-b27f-b44c35332a13

	/// Highest hourly demand for the selection in the last 7 days.
	measure 'Peak demand MW, last 7 days' =
			VAR c = [Cut-off]
			RETURN
				CALCULATE ( [Peak demand MW], Reading[reading_hour] > c - 7, REMOVEFILTERS ( 'Date' ) )
		formatString: #,0.0
		displayFolder: Load
		lineageTag: f85c5350-9702-531c-b231-b98b49852bcb

	column feeder_id
