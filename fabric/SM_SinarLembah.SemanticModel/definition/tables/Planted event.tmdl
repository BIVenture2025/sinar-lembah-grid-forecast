/// The anomalies the generator planted, graded: matured, caught, alerts.
table 'Planted event'
	lineageTag: c9e0f6cd-965d-5567-bb7b-4eff696ce319

	/// Planted events in the grading window that ended at least a day before the cut-off.
	measure 'Events matured' = COALESCE ( CALCULATE ( COUNTROWS ( 'Planted event' ), 'Planted event'[in_window] = TRUE (), 'Planted event'[is_matured] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Detector
		lineageTag: 5ccc1325-f458-5f62-9c81-732ed3896f48

	/// Matured events with at least one alert inside the event window.
	measure 'Events caught' = COALESCE ( CALCULATE ( COUNTROWS ( 'Planted event' ), 'Planted event'[in_window] = TRUE (), 'Planted event'[is_matured] = TRUE (), 'Planted event'[is_caught] = TRUE () ), 0 )
		formatString: #,0
		displayFolder: Detector
		lineageTag: 4b28dbca-8167-57ef-9529-7daac3285695

	/// Events caught over events matured; matured only, never blended with young events.
	measure Recall = DIVIDE ( [Events caught], [Events matured] )
		formatString: 0%
		displayFolder: Detector
		lineageTag: e3d2fdbc-1006-5402-b3bb-b0b3259a1622

