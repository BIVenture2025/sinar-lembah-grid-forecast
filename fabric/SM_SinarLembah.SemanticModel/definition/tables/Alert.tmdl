/// One row per alert hour; incidents group consecutive hours on one feeder.
table Alert
	lineageTag: 934836f7-1b31-5264-bfba-71dbe24567eb

	/// Feeder-hours with an alert.
	measure 'Alert hours' = COUNTROWS ( Alert )
		formatString: #,0
		displayFolder: Alerts
		lineageTag: 10afe940-998e-5ea7-be8f-1c90021f0155

	/// Runs of alerts on one feeder in back-to-back hours; one quiet hour ends an incident.
	measure Incidents = DISTINCTCOUNT ( Alert[incident_id] )
		formatString: #,0
		displayFolder: Alerts
		lineageTag: c729c677-5809-56f3-bdea-2b69c449b205

	/// Incidents with an alert hour in the 24 hours up to the cut-off.
	measure 'Incidents last 24 h' =
			VAR c = [Cut-off]
			RETURN
				COALESCE ( CALCULATE ( [Incidents], Alert[reading_hour] > c - 1, REMOVEFILTERS ( 'Date' ) ), 0 )
		formatString: #,0
		displayFolder: Alerts
		lineageTag: 48e5ce1b-a8f7-575d-8ae3-d7da684ea409

	/// Incidents with an alert hour in the 7 days up to the cut-off.
	measure 'Incidents last 7 days' =
			VAR c = [Cut-off]
			RETURN
				COALESCE ( CALCULATE ( [Incidents], Alert[reading_hour] > c - 7, REMOVEFILTERS ( 'Date' ) ), 0 )
		formatString: #,0
		displayFolder: Alerts
		lineageTag: fc3dbf29-baec-50fe-aa07-c0f3f551ee02

	/// Incidents in the 7 days before the last 7.
	measure 'Incidents previous 7 days' =
			VAR c = [Cut-off]
			RETURN
				COALESCE ( CALCULATE ( [Incidents], Alert[reading_hour] > c - 14, Alert[reading_hour] <= c - 7, REMOVEFILTERS ( 'Date' ) ), 0 )
		formatString: #,0
		displayFolder: Alerts
		lineageTag: 8cca200a-f860-535a-9700-ce5710272594

	/// Alert hours in the last 7 days.
	measure 'Alert hours last 7 days' =
			VAR c = [Cut-off]
			RETURN
				CALCULATE ( [Alert hours], Alert[reading_hour] > c - 7, REMOVEFILTERS ( 'Date' ) )
		formatString: #,0
		displayFolder: Alerts
		lineageTag: 3c5902cf-9bb6-5785-bc34-d71ae721181d

	/// Feeders with any alert in the last 7 days.
	measure 'Feeders with alerts 7 days' =
			VAR c = [Cut-off]
			RETURN
				COALESCE ( CALCULATE ( DISTINCTCOUNT ( Alert[feeder_id] ), Alert[reading_hour] > c - 7, REMOVEFILTERS ( 'Date' ) ), 0 )
		formatString: #,0
		displayFolder: Alerts
		lineageTag: c3813236-7069-5054-b538-c6ba93ed5068

	/// Share of last-7-day alert hours that a logged load transfer covers.
	measure 'Switching share 7 days' =
			VAR c = [Cut-off]
			VAR sw = CALCULATE ( [Alert hours], Alert[cause] = "Planned switching", Alert[reading_hour] > c - 7, REMOVEFILTERS ( 'Date' ) )
			RETURN
				DIVIDE ( sw, [Alert hours last 7 days] )
		formatString: 0%
		displayFolder: Alerts
		lineageTag: c40a5fba-22bd-5309-8e91-288181b4bb4e

	/// Matured alert hours that fall inside a planted event (precision against the answer key).
	measure 'Planted share of alert hours' =
			VAR m = CALCULATE ( [Alert hours], Alert[is_matured] = TRUE () )
			VAR p = CALCULATE ( [Alert hours], Alert[is_matured] = TRUE (), Alert[grade_cause] = "Planted event" )
			RETURN
				DIVIDE ( p, m )
		formatString: 0%
		displayFolder: Detector
		lineageTag: 1df89b23-612f-5a10-9a8e-8fe502b46f99

	/// Alert hours over the days in context that fall in the 30 days up to the cut-off; blank when none do (works by date or by weekday).
	measure 'Alert hours, last 30 days' =
			VAR c = [Cut-off]
			VAR win = FILTER ( VALUES ( 'Date'[date] ), 'Date'[date] > c - 30 && 'Date'[date] <= c )
			RETURN
				IF ( NOT ISEMPTY ( win ), COALESCE ( CALCULATE ( [Alert hours], win ), 0 ) )
		formatString: #,0
		displayFolder: Alerts
		lineageTag: 40bd04d4-2033-565d-a536-918b3092648d

	/// Alert hours over the days in context that fall in the 7 days up to the cut-off; blank when none do (works by date or by weekday).
	measure 'Alert hours by day, last 7 days' =
			VAR c = [Cut-off]
			VAR win = FILTER ( VALUES ( 'Date'[date] ), 'Date'[date] > c - 7 && 'Date'[date] <= c )
			RETURN
				IF ( NOT ISEMPTY ( win ), COALESCE ( CALCULATE ( [Alert hours], win ), 0 ) )
		formatString: #,0
		displayFolder: Alerts
		lineageTag: 98c6c6b6-26b8-518d-a454-f02f0cd80748

	/// Footer on every page: synthetic data and the cut-off, read from the data.
	measure Disclaimer =
			"Synthetic data for a fictional distributor. Readings up to " & FORMAT ( [Cut-off], "d mmm yyyy hh:nn" )
				& ", Malaysia time. Demand in MW, energy in MWh."
		displayFolder: Narrative
		lineageTag: a6456485-08f0-5e9d-887b-42b46b604dce

	/// Home: the as-of hour, read from the data.
	measure 'Eyebrow Home' = "As of " & FORMAT ( [Cut-off], "d mmm yyyy, hh:nn" )
		displayFolder: Narrative
		lineageTag: 6bc6b22e-3f94-5581-942c-4eef693211c2

	/// Home: what the report watches, counts read from the data.
	measure 'Subtitle Home' =
			VAR nf = CALCULATE ( DISTINCTCOUNT ( Feeder[feeder_id] ), REMOVEFILTERS () )
			VAR ns = CALCULATE ( DISTINCTCOUNT ( Feeder[substation_id] ), REMOVEFILTERS () )
			RETURN
				nf & " feeders across " & ns & " main distribution substations report every hour. A reading far from the feeder's usual load "
				& "raises an alert as it arrives. A day-ahead forecast gives tomorrow's demand hour by hour, with a range."
		displayFolder: Narrative
		lineageTag: 9009a4c6-5e41-500e-b01f-ce87574f1a0f

	/// Meter Watch takeaway: last-24-hour incidents, the busiest substation this week and the switching share.
	measure 'Title Meter Watch' =
			VAR i24 = [Incidents last 24 h]
			VAR t = TOPN ( 1, VALUES ( Feeder[substation_name] ), [Alert hours last 7 days], DESC )
			VAR topName = MAXX ( t, Feeder[substation_name] )
			VAR topHours = COALESCE ( MAXX ( t, [Alert hours last 7 days] ), 0 )
			VAR sw = COALESCE ( [Switching share 7 days], 0 )
			RETURN
				FORMAT ( i24, "#,0" ) & IF ( i24 = 1, " incident", " incidents" ) & " in the last 24 hours. "
				& IF ( topHours > 0, topName & " had the most alert hours this week (" & FORMAT ( topHours, "#,0" ) & "); " & FORMAT ( sw, "0%" )
					& " of this week's alert hours fall in planned switching.", "No alert hours this week." )
		displayFolder: Narrative
		lineageTag: 08e491b7-4bba-5041-b045-99ddcece300f

