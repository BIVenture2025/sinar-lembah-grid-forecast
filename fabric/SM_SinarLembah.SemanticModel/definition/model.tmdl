model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_ServiceStoredInTmdl = reserved

ref table Reading
ref table Alert
ref table Forecast
ref table 'Forecast group'
ref table 'Planted event'
ref table 'Model metric'
ref table 'Detector metric'
ref table Feeder
ref table Date
ref table Hour
